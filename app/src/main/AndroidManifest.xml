<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Android 11+ package visibility -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".NemotronApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NemotronVoiceIME">

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- ============================================================== -->
        <!--  MainActivity: TOGGLE INVISIBLE (es el LAUNCHER por defecto).  -->
        <!-- ============================================================== -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@style/Theme.NemotronVoiceIME.Transparent"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ============================================================== -->
        <!--  SetupActivity: wizard de configuracion.                       -->
        <!-- ============================================================== -->
        <activity-alias
            android:name=".SetupActivityAlias"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="Nemotron Setup"
            android:targetActivity=".ui.SetupActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.SetupActivity"
            android:exported="false"
            android:label="Nemotron Setup" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".ui.SetupActivity" />

        <!-- ============================================================== -->
        <!--  AppPickerActivity: seleccionar apps a congelar (freeze).       -->
        <!--  Tambien es target del long-press en el QS tile.              -->
        <!-- ============================================================== -->
        <activity
            android:name=".dhizuku.AppPickerActivity"
            android:exported="true"
            android:label="Freeze Apps"
            android:theme="@style/Theme.NemotronVoiceIME"
            android:windowSoftInputMode="adjustResize">
        </activity>

        <!-- Long-press en tiles abre la app correspondiente -->
        <activity
            android:name=".dhizuku.TilePreferencesActivity"
            android:exported="true"
            android:theme="@style/Theme.NemotronVoiceIME.Transparent">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
        </activity>

        <!-- Foreground service de grabación de voz -->
        <service
            android:name=".record.VoiceRecordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Guard anti-adicción: apaga la pantalla y cierra Instagram al abrir Reels o tras mucho scroll en Inicio, y WhatsApp si ves Status.
             Event-driven (accesibilidad), sin polling ni gasto de batería -->
        <service
            android:name=".guard.AntiScrollAccessibilityService"
            android:exported="false"
            android:label="@string/guard_a11y_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice.AccessibilityServiceInfo"
                android:resource="@xml/accessibility_guard_config" />
        </service>

        <!-- Temp receiver para descongelar apps desde adb -->
        <receiver
            android:name=".dhizuku.UnhideReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.nemotron.voiceime.UNHIDE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".dhizuku.AutoFreezeBootReceiver"
            android:exported="false"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- ============================================================== -->
        <!--  Tiles dedicados: congelar/descongelar una app concreta.        -->
        <!-- ============================================================== -->
        <service
            android:name=".dhizuku.AndroidAutoTileService"
            android:exported="true"
            android:icon="@drawable/ic_auto_tile"
            android:label="Android Auto"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".dhizuku.TelegramTileService"
            android:exported="true"
            android:icon="@drawable/ic_telegram_tile"
            android:label="Telegram"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".dhizuku.GmsTileService"
            android:exported="true"
            android:icon="@drawable/ic_gms_tile"
            android:label="GMS"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".dhizuku.SyncthingTileService"
            android:exported="true"
            android:icon="@drawable/ic_syncthing_tile"
            android:label="Syncthing"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Wallet: tap abre Wallet + NFC on/off sin service en background -->
        <service
            android:name=".dhizuku.WalletTileService"
            android:exported="true"
            android:icon="@drawable/ic_wallet_tile"
            android:label="Wallet"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Galaxy Wearable: congelar/descongelar la app de Samsung -->
        <service
            android:name=".dhizuku.WatchManagerTileService"
            android:exported="true"
            android:icon="@drawable/ic_watch_tile"
            android:label="Galaxy Wearable"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Galaxy Fit3 Plugin: congelar/descongelar el plugin de la pulsera -->
        <service
            android:name=".dhizuku.Fit3TileService"
            android:exported="true"
            android:icon="@drawable/ic_fit3_tile"
            android:label="Fit3 Plugin"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
