<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090E17">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingTop="92dp"
            android:paddingBottom="112dp" />
        <TextView
            android:id="@+id/welcomeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Hi, I'm adarbot.\nHow can I help you?"
            android:textColor="#F5F5F7"
            android:textSize="27sp"
            android:textStyle="bold" />
    </FrameLayout>

    </LinearLayout>

    <!-- Header flotante: no reserva espacio ni pinta un fondo alrededor. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:background="@android:color/transparent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="0dp"
        android:paddingRight="0dp">
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:gravity="center_vertical|start"
            android:paddingLeft="8dp"
            android:translationX="4dp">
            <ImageButton
                android:id="@+id/btnMenuChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="Open chat menu"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                android:tint="#8FC1FF" />
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:tint="#EDEDF0"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/convTitle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="adarbot"
            android:textColor="#EDEDF0"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="invisible" />
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:gravity="center_vertical|end">
            <ImageButton
                android:id="@+id/btnIncognitoHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="New incognito chat"
                android:padding="9dp"
                android:src="@drawable/ic_ghost"
                android:tint="#8FC1FF" />
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="Delete conversation"
                android:padding="10dp"
                android:src="@drawable/ic_trash"
                android:tint="#8FC1FF"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chatAttachmentPreview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginLeft="22dp"
        android:layout_marginBottom="82dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="6dp"
        android:background="@drawable/bg_assist_preview"
        android:clipToOutline="true"
        android:elevation="24dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/chatAttachmentImage"
            android:layout_width="72dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_assist_preview"
            android:clipToOutline="true"
            android:contentDescription="Attachment preview"
            android:outlineProvider="background"
            android:scaleType="centerCrop"
            android:visibility="gone" />
        <ImageView
            android:id="@+id/chatFileIcon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginLeft="6dp"
            android:contentDescription="File icon"
            android:src="@drawable/ic_file"
            android:tint="#8FC1FF"
            android:visibility="gone" />
        <TextView
            android:id="@+id/chatFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:maxWidth="140dp"
            android:textColor="#EDEDF0"
            android:textSize="13sp"
            android:visibility="gone" />
        <ImageButton
            android:id="@+id/chatAttachmentRemove"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_assist_icon"
            android:contentDescription="Remove attachment"
            android:padding="6dp"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Deliberately sits over the chat rather than consuming layout height. -->
    <LinearLayout
        android:id="@+id/chatComposer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_float_bar"
        android:elevation="24dp"
        android:translationZ="8dp"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/modelChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_chip"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:text="DeepSeek"
            android:textColor="#C9C9D6"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Attach"
            android:padding="9dp"
            android:src="@drawable/ic_attach"
            android:tint="#8FC1FF" />

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="2dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:hint="Ask adarbot..."
            android:imeOptions="actionSend|flagNoFullscreen"
            android:importantForAutofill="no"
            android:inputType="text|textNoSuggestions"
            android:maxLines="1"
            android:singleLine="true"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:textColor="#EDEDF0"
            android:textColorHint="#8E8EA3"
            android:textColorHighlight="@color/adarbot_selection"
            android:lineSpacingExtra="4dp"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Voice input"
            android:padding="10dp"
            android:src="@drawable/ic_mic"
            android:tint="#C9C9D6" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">
            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="Send"
                android:padding="10dp"
                android:src="@drawable/ic_send"
                android:tint="#2F80FF" />
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
