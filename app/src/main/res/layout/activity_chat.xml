<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090E17">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="8dp"
        android:background="@android:color/transparent"
        android:elevation="0dp"
        android:translationZ="0dp"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/btnMenuChat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="Abrir menú de chats"
                android:padding="8dp"
                android:src="@drawable/ic_menu"
                android:tint="#8FC1FF" />
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Volver"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:tint="#EDEDF0"
                android:visibility="gone" />
            <View
                android:id="@+id/connectionDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="3dp"
                android:translationX="56dp"
                android:background="@drawable/bg_connection_offline" />
        </LinearLayout>

        <TextView
            android:id="@+id/convTitle"
            android:layout_width="220dp"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="adarbot"
            android:textColor="#EDEDF0"
            android:textSize="17sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/btnIncognitoHome"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_chip"
                android:contentDescription="Nuevo chat incógnito"
                android:padding="9dp"
                android:src="@drawable/ic_ghost"
                android:tint="#8FC1FF" />
            <ImageButton
                android:id="@+id/btnDelete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar conversacion"
                android:padding="10dp"
                android:src="@drawable/ic_trash"
                android:tint="#5A5A6E"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="112dp" />
        <TextView
            android:id="@+id/welcomeView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="Hola, soy adarbot.\n¿En qué te ayudo?"
            android:textColor="#F5F5F7"
            android:textSize="27sp"
            android:textStyle="bold" />
    </FrameLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/chatAttachmentPreview"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="22dp"
        android:layout_marginBottom="112dp"
        android:padding="4dp"
        android:background="@drawable/bg_float_bar"
        android:elevation="24dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/chatAttachmentImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Vista previa del adjunto"
            android:scaleType="centerCrop" />
        <ImageButton
            android:id="@+id/chatAttachmentRemove"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_assist_icon"
            android:contentDescription="Quitar adjunto"
            android:padding="7dp"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF" />
    </FrameLayout>

    <!-- Deliberately sits over the chat rather than consuming layout height. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_float_bar"
        android:elevation="24dp"
        android:translationZ="8dp"
        android:gravity="end"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/modelChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="4dp"
            android:layout_marginBottom="3dp"
            android:background="@drawable/bg_chip"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:text="DeepSeek"
            android:textColor="#C9C9D6"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnAttach"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Adjuntar"
            android:padding="9dp"
            android:src="@drawable/ic_attach"
            android:tint="#8FC1FF" />

        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="Escribir por voz"
            android:padding="10dp"
            android:src="@drawable/ic_mic"
            android:tint="#C9C9D6" />

        <EditText
            android:id="@+id/inputField"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginLeft="0dp"
            android:layout_marginRight="2dp"
            android:background="@android:color/transparent"
            android:hint="Escribe tu mensaje..."
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:textColor="#EDEDF0"
            android:textColorHint="#8E8EA3"
            android:textSize="14sp" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">
            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="Enviar"
                android:padding="10dp"
                android:src="@drawable/ic_send"
                android:tint="#2F80FF" />
            <ImageView
                android:id="@+id/modelBadge"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_model_badge"
                android:contentDescription="Modelo seleccionado"
                android:padding="2dp" />
        </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
