<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090E17"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="24dp"
        android:paddingTop="24dp"
        android:paddingRight="16dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/menuBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="Menu de adarbot"
            android:padding="10dp"
            android:src="@drawable/ic_menu"
            android:tint="#8FC1FF" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

        <TextView
            android:id="@+id/homeGreeting"
            android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="adarbot"
                android:textColor="#F5F5F7"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.02" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/incognitoBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="Modo incognito"
            android:src="@drawable/ic_ghost"
            android:tint="#5A5A6E"
            android:padding="10dp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Qué hacemos hoy?"
                android:textColor="#F5F5F7"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Pregúntale a adarbot"
                android:textColor="#8E9DB5"
                android:textSize="16sp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="22dp"
                android:layout_marginTop="28dp"
                android:layout_marginRight="22dp"
                android:background="@drawable/bg_float_bar"
                android:gravity="center_vertical"
                android:paddingLeft="12dp"
                android:paddingTop="8dp"
                android:paddingRight="8dp"
                android:paddingBottom="8dp">
                <EditText
                    android:id="@+id/homeInput"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Pregúntale a adarbot..."
                    android:imeOptions="actionSend"
                    android:maxLines="1"
                    android:paddingLeft="14dp"
                    android:paddingRight="8dp"
                    android:textColor="#EDEDF0"
                    android:textColorHint="#8E9DB5" />
                <ImageButton
                    android:id="@+id/homeSend"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Enviar"
                    android:padding="10dp"
                    android:src="@drawable/ic_send"
                    android:tint="#2F80FF" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerChats"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="96dp" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Sin conversaciones\nToca + para empezar"
            android:textColor="#5A5A6E"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/fabNew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|bottom"
            android:layout_margin="20dp"
            android:background="@drawable/bg_chip"
            android:contentDescription="Nueva conversacion"
            android:src="@drawable/ic_plus"
            android:tint="#FFFFFF" />
    </FrameLayout>
</LinearLayout>
