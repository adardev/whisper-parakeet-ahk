<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assistRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/transparent">
    <com.nemotron.voiceime.chat.AssistGlowView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/assistScreenshotPill"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginLeft="24dp"
        android:layout_marginBottom="124dp"
        android:background="@drawable/bg_assist_panel"
        android:elevation="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="14dp">
        <ImageButton
            android:id="@+id/assistScreenshot"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_assist_icon"
            android:contentDescription="Capturar pantalla"
            android:padding="8dp"
            android:src="@drawable/ic_screenshot"
            android:tint="#8FC1FF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:gravity="center_vertical"
            android:includeFontPadding="true"
            android:text="Capturar pantalla"
            android:textColor="#E8F1FF"
            android:textSize="13sp" />
    </LinearLayout>
    <HorizontalScrollView
        android:id="@+id/assistPreviewWrap"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:scrollbars="none"
        android:layout_gravity="bottom|start"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="22dp"
        android:layout_marginBottom="124dp"
        android:clipToPadding="false"
        android:padding="4dp"
        android:background="@android:color/transparent"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_assist_preview"
                android:padding="4dp">
            <ImageView
                android:id="@+id/assistPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_assist_preview"
                android:clipToOutline="true"
                android:contentDescription="Vista previa de captura"
                android:outlineProvider="background"
                android:scaleType="centerCrop" />
            <ImageButton
                android:id="@+id/assistPreviewRemove"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_vertical|end"
                android:layout_marginRight="8dp"
                android:background="@drawable/bg_assist_icon"
                android:contentDescription="Quitar captura"
                android:padding="9dp"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout
        android:id="@+id/assistPanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:layout_margin="14dp"
        android:paddingLeft="4dp" android:paddingTop="4dp" android:paddingRight="4dp" android:paddingBottom="10dp"
        android:background="@drawable/bg_assist_panel" android:elevation="24dp"
        android:focusable="true" android:focusableInTouchMode="true">
    <FrameLayout
        android:id="@+id/assistDragHandle"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:paddingTop="5dp"
        android:paddingBottom="3dp">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_drag_handle" />
    </FrameLayout>
    <TextView android:id="@+id/assistStatus" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:gravity="end|center_vertical"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="3dp"
        >
        <TextView
            android:id="@+id/assistModelChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:background="@drawable/bg_chip"
            android:paddingLeft="12dp"
            android:paddingTop="5dp"
            android:paddingRight="12dp"
            android:paddingBottom="5dp"
            android:text="DeepSeek"
            android:textColor="#C9C9D6"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:layout_marginBottom="2dp" android:background="@android:color/transparent" android:gravity="center_vertical" android:paddingLeft="8dp" android:paddingTop="4dp" android:paddingRight="8dp" android:paddingBottom="4dp">
        <ImageButton android:id="@+id/assistAttach" android:layout_width="32dp" android:layout_height="32dp" android:background="@drawable/bg_assist_icon" android:src="@drawable/ic_attach" android:tint="#8FC1FF" android:padding="6dp" android:contentDescription="Adjuntar" />
        <EditText android:id="@+id/assistInput" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginLeft="4dp" android:layout_marginRight="4dp" android:background="@android:color/transparent" android:hint="Pregúntale a adarbot..." android:singleLine="true" android:imeOptions="actionSend" android:paddingLeft="14dp" android:paddingRight="14dp" android:textColor="#EDEDF0" android:textColorHint="#8E8EA3" android:textSize="14sp" />
        <ImageButton android:id="@+id/assistMic" android:layout_width="36dp" android:layout_height="36dp" android:background="@drawable/bg_assist_icon" android:src="@drawable/ic_mic" android:tint="#C9C9D6" android:padding="8dp" android:contentDescription="Hablar con adarbot" />
        <FrameLayout android:layout_width="36dp" android:layout_height="36dp">
            <ImageButton android:id="@+id/assistSend" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_assist_icon" android:src="@drawable/ic_send" android:tint="#2F80FF" android:padding="8dp" android:contentDescription="Enviar" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
