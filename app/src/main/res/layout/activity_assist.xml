<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assistRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@android:color/transparent">
    <com.nemotron.voiceime.chat.AssistGlowView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:importantForAccessibility="no" />
    <LinearLayout
        android:id="@+id/assistScreenshotPill"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="bottom|start"
        android:layout_marginLeft="24dp"
        android:layout_marginBottom="105dp"
        android:background="@drawable/bg_assist_panel"
        android:elevation="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="14dp">
        <ImageButton
            android:id="@+id/assistScreenshot"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_assist_icon"
            android:contentDescription="Take screenshot"
            android:padding="8dp"
            android:src="@drawable/ic_screenshot"
            android:tint="#8FC1FF" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginLeft="8dp"
            android:gravity="center_vertical"
            android:includeFontPadding="true"
            android:text="Take screenshot"
            android:textColor="#E8F1FF"
            android:textSize="13sp" />
    </LinearLayout>
    <HorizontalScrollView
        android:id="@+id/assistPreviewWrap"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:scrollbars="none"
        android:layout_gravity="bottom|start"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="22dp"
        android:layout_marginBottom="82dp"
        android:clipToPadding="false"
        android:padding="4dp"
        android:background="@android:color/transparent"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_assist_preview"
                android:padding="6dp">
            <ImageView
                android:id="@+id/assistPreview"
                android:layout_width="72dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_assist_preview"
                android:clipToOutline="true"
                android:contentDescription="Screenshot preview"
                android:outlineProvider="background"
                android:scaleType="centerCrop"
                android:visibility="gone" />
            <ImageView
                android:id="@+id/assistFileIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginLeft="6dp"
                android:contentDescription="File icon"
                android:src="@drawable/ic_file"
                android:tint="#8FC1FF"
                android:visibility="gone" />
            <TextView
                android:id="@+id/assistFileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:layout_marginRight="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="140dp"
                android:textColor="#EDEDF0"
                android:textSize="13sp"
                android:visibility="gone" />
            <ImageButton
                android:id="@+id/assistPreviewRemove"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_assist_icon"
                android:contentDescription="Remove screenshot"
                android:padding="6dp"
                android:src="@drawable/ic_close"
                android:tint="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout
        android:id="@+id/assistPanel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:layout_margin="14dp"
        android:paddingLeft="4dp" android:paddingTop="2dp" android:paddingRight="4dp" android:paddingBottom="10dp"
        android:background="@drawable/bg_assist_panel" android:elevation="24dp"
        android:focusable="true" android:focusableInTouchMode="true">
    <FrameLayout
        android:id="@+id/assistDragHandle"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp">
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_drag_handle" />
    </FrameLayout>
    <TextView android:id="@+id/assistStatus" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
    <TextView
        android:id="@+id/assistModelChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginRight="8dp"
        android:layout_marginBottom="2dp"
        android:background="@drawable/bg_chip"
        android:paddingLeft="12dp"
        android:paddingTop="5dp"
        android:paddingRight="12dp"
        android:paddingBottom="5dp"
        android:text="DeepSeek"
        android:textColor="#C9C9D6"
        android:textSize="12sp"
        android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="8dp" android:layout_marginRight="8dp" android:layout_marginBottom="4dp" android:gravity="center_vertical" android:paddingLeft="8dp" android:paddingTop="6dp" android:paddingRight="8dp" android:paddingBottom="6dp">
        <ImageButton android:id="@+id/assistAttach" android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_assist_icon" android:src="@drawable/ic_attach" android:tint="#8FC1FF" android:padding="8dp" android:contentDescription="Attach" />
        <EditText android:id="@+id/assistInput" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="4dp" android:layout_marginRight="4dp" android:background="@android:color/transparent" android:gravity="center_vertical" android:hint="Ask adarbot..." android:inputType="textMultiLine|textNoSuggestions" android:maxLines="6" android:imeOptions="actionSend|flagNoFullscreen" android:paddingLeft="18dp" android:paddingRight="18dp" android:textColor="#EDEDF0" android:textColorHint="#8E8EA3" android:textColorHighlight="@color/adarbot_selection" android:lineSpacingExtra="4dp" android:textSize="14sp" />
        <ImageButton android:id="@+id/assistMic" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_assist_icon" android:src="@drawable/ic_mic" android:tint="#C9C9D6" android:padding="10dp" android:contentDescription="Talk to adarbot" />
        <FrameLayout android:layout_width="42dp" android:layout_height="42dp">
            <ImageButton android:id="@+id/assistSend" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_assist_icon" android:src="@drawable/ic_send" android:tint="#2F80FF" android:padding="10dp" android:contentDescription="Send" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
