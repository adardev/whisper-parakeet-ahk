<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_gravity="bottom" android:orientation="vertical"
    android:background="@drawable/bg_assist_panel" android:elevation="24dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:layout_width="32dp" android:layout_height="32dp" android:gravity="center" android:text="H" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="16sp" android:background="@drawable/bg_assist_orb" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginLeft="10dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hermes" android:textColor="#F4F3FA" android:textStyle="bold" android:textSize="16sp" />
            <TextView android:id="@+id/assistStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Listo" android:textColor="#9B9DB6" android:textSize="12sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/assistExpand" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:src="@drawable/ic_expand" android:tint="#9B9DB6" android:contentDescription="Abrir chat completo" />
        <ImageButton android:id="@+id/assistClose" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:src="@drawable/ic_close" android:tint="#9B9DB6" android:contentDescription="Cerrar" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical">
        <ImageButton android:id="@+id/assistMic" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_assist_orb" android:src="@drawable/ic_mic" android:tint="#FFFFFF" android:padding="10dp" android:contentDescription="Hablar con Hermes" />
        <EditText android:id="@+id/assistInput" android:layout_width="0dp" android:layout_height="46dp" android:layout_weight="1" android:layout_marginLeft="10dp" android:layout_marginRight="8dp" android:background="@drawable/bg_input" android:hint="Pregúntale algo..." android:singleLine="true" android:imeOptions="actionSend" android:paddingLeft="16dp" android:paddingRight="16dp" android:textColor="#F4F3FA" android:textColorHint="#777A95" />
        <ImageButton android:id="@+id/assistSend" android:layout_width="44dp" android:layout_height="44dp" android:background="@android:color/transparent" android:src="@drawable/ic_send" android:tint="#9B9DFF" android:padding="10dp" android:contentDescription="Enviar" />
    </LinearLayout>
</LinearLayout>
