<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF1A1A2E"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="←"
            android:textSize="20sp"
            android:backgroundTint="#FF3A3A5E"
            android:textColor="#FFFFFFFF"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Select apps to freeze"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingStart="12dp" />
    </LinearLayout>

    <!-- App list -->
    <ListView
        android:id="@+id/appListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#20FFFFFF"
        android:dividerHeight="1dp"
        android:choiceMode="multipleChoice"
        android:stackFromBottom="true" />

    <!-- Auto-freeze toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingVertical="10dp"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-freeze on lock"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Freeze apps on screen off, unfreeze on unlock"
                android:textColor="#99FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <Switch
            android:id="@+id/switchAutoFreeze"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumbTint="#FF00D4AA"
            android:trackTint="#FF3A3A5E" />
    </LinearLayout>

    <!-- Save button -->
    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Save &amp; Apply"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#FF00D4AA"
        android:textColor="#FF000000"
        android:layout_marginTop="4dp" />

</LinearLayout>
