<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:icon="@mipmap/ic_launcher"
        app:title="Dictado">

        <ListPreference
            app:key="dict_locale"
            app:title="@string/settings_locale"
            app:entries="@array/locales_entries"
            app:entryValues="@array/locales_values"
            app:defaultValue="es_ES" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Anti-adicción">
        <SwitchPreferenceCompat
            app:key="addiction_guard_enabled"
            app:title="@string/guard_title"
            app:summary="@string/guard_summary"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="dnd_lock_enabled"
            app:title="@string/dnd_lock_title"
            app:summary="@string/dnd_lock_summary"
            app:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Red">
        <Preference
            app:key="dns_enforcer_status"
            app:title="DNS privado protegido"
            app:summary="Siempre activo mientras Nemotron esté instalado: b1ed39.dns.nextdns.io" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Estado">
        <Preference
            app:key="status"
            app:title="Estado"
            app:summary="API key no configurada" />
    </PreferenceCategory>

</PreferenceScreen>
