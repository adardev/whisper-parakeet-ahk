<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:icon="@mipmap/ic_launcher"
        app:title="Dictation">

        <ListPreference
            app:key="dict_locale"
            app:title="@string/settings_locale"
            app:entries="@array/locales_entries"
            app:entryValues="@array/locales_values"
            app:defaultValue="es_ES" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Anti-addiction">
        <SwitchPreferenceCompat
            app:key="addiction_guard_enabled"
            app:title="@string/guard_title"
            app:summary="@string/guard_summary"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="dnd_lock_enabled"
            app:title="@string/dnd_lock_title"
            app:summary="@string/dnd_lock_summary"
            app:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Network">
        <Preference
            app:key="dns_enforcer_status"
            app:title="Private DNS protected"
            app:summary="Always active while Nemotron is installed: b1ed39.dns.nextdns.io" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Status">
        <Preference
            app:key="status"
            app:title="Status"
            app:summary="API key not configured" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Health Connect (NAS)">
        <Preference
            app:key="health_setup"
            app:title="Enable health transfer"
            app:summary="Grant permissions and send steps, sleep, heart rate and more to NAS (192.168.0.2:9090)" />
        <EditTextPreference
            app:key="health_webhook_url"
            app:title="Webhook URL"
            app:defaultValue="http://192.168.0.2:9090/webhook"
            app:summary="NAS webhook URL where data is sent" />
        <Preference
            app:key="health_send_now"
            app:title="Send data now"
            app:summary="Read and send Health Connect data immediately" />
    </PreferenceCategory>

</PreferenceScreen>
