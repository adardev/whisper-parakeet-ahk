<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory
        app:icon="@mipmap/ic_launcher"
        app:title="NVIDIA NIM">

        <EditTextPreference
            app:key="api_key"
            app:title="@string/settings_api_key"
            app:summary="@string/settings_api_key_summary"
            app:useSimpleSummaryProvider="false"
            app:dialogMessage="@string/api_key_help" />

        <EditTextPreference
            app:key="model"
            app:title="@string/settings_model"
            app:defaultValue="@string/settings_model_default" />

        <EditTextPreference
            app:key="system_prompt"
            app:title="@string/settings_system_prompt"
            app:defaultValue="@string/settings_system_prompt_default"
            app:dialogMessage="Indica al modelo cómo transcribir" />

        <ListPreference
            app:key="dict_locale"
            app:title="@string/settings_locale"
            app:entries="@array/locales_entries"
            app:entryValues="@array/locales_values"
            app:defaultValue="es_ES" />

    </PreferenceCategory>

    <PreferenceCategory app:title="Anti-adicción">
        <SwitchPreferenceCompat
            app:key="addiction_guard_enabled"
            app:title="@string/guard_title"
            app:summary="@string/guard_summary"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="dnd_lock_enabled"
            app:title="@string/dnd_lock_title"
            app:summary="@string/dnd_lock_summary"
            app:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Red">
        <Preference
            app:key="dns_enforcer_status"
            app:title="DNS privado protegido"
            app:summary="Siempre activo mientras Nemotron esté instalado: b1ed39.dns.nextdns.io" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Estado">
        <Preference
            app:key="status"
            app:title="Estado"
            app:summary="API key no configurada" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Health Connect (NAS)">
        <Preference
            app:key="health_setup"
            app:title="Activar transferencia de salud"
            app:summary="Otorga permisos y envia pasos, sueño, ritmo cardiaco y más al NAS (192.168.0.2:9090)" />
        <EditTextPreference
            app:key="health_webhook_url"
            app:title="Webhook URL"
            app:defaultValue="http://192.168.0.2:9090/webhook"
            app:summary="URL del webhook del NAS donde se envian los datos" />
        <Preference
            app:key="health_send_now"
            app:title="Enviar datos ahora"
            app:summary="Lee y envia los datos de Health Connect inmediatamente" />
    </PreferenceCategory>

</PreferenceScreen>
