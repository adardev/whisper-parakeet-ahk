<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:clipToPadding="false">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/welcome_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:textColor="@color/bg_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nemotron Core controls your tiles, app freezing, Sleep Mode, and device settings. Voice typing is provided by Nemotron Keyboard."
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_dim" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configure"
            android:layout_marginTop="8dp" />

        <!-- Auto Freeze Section -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvAutoFreezeIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="?"
                android:textSize="18sp"
                android:background="#33000000" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Auto Freeze (screen off)"
                android:textSize="16sp"
                android:textStyle="bold" />
            <Switch
                android:id="@+id/switchAutoFreeze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Automatically freezes selected apps when screen turns off and unfreezes on wake."
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_dim" />
        <Button
            android:id="@+id/btnAutoFreezeApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select apps"
            android:layout_marginTop="8dp" />
        <Button
            android:id="@+id/btnStopBackgroundServices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select background services to stop"
            android:layout_marginTop="4dp" />
        <TextView
            android:id="@+id/tvAutoFreezeStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/text_dim" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Test mode (instant freeze)"
                android:textSize="14sp" />
            <Switch
                android:id="@+id/switchAutoFreezeInstant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Deep doze on screen off"
                android:textSize="14sp" />
            <Switch
                android:id="@+id/switchAutoFreezeDoze"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forces deep doze immediately on screen off (saves battery, postpones notifications from non-whitelisted apps until unlock)."
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/text_dim" />
        <Button
            android:id="@+id/btnAutoFreezeDozeExempt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apps excluded from deep doze"
            android:layout_marginTop="4dp" />

        <!-- KernelSU root access -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginTop="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/tvKernelSUIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="?"
                android:textSize="18sp"
                android:background="#33000000" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="KernelSU root access"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nemotron uses KernelSU root for system controls and Quick Settings tiles."
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_dim" />
        <TextView
            android:id="@+id/tvKernelSUStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/text_dim" />
        <Button
            android:id="@+id/btnKernelSUPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Request KernelSU root access"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#22000000"
            android:layout_marginTop="20dp" />

        <!-- Atajos de apps -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App shortcuts"
            android:layout_marginTop="16dp"
            android:textSize="16sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Opens apps even when frozen."
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text_dim" />
        <Button
            android:id="@+id/btnAddShortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add app shortcuts to home"
            android:layout_marginTop="8dp" />

        <!-- Keep existing actions wired for compatibility while hiding their controls. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">
            <Button android:id="@+id/btnSideKey" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <Button android:id="@+id/btnEscolomos" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
